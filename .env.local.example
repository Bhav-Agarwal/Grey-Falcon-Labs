# Grey Falcon Labs — environment template.
# Copy to .env.local and fill in. NEVER commit .env.local (it is git-ignored).

# Public site URL (used for SEO / Open Graph absolute URLs).
NEXT_PUBLIC_SITE_URL=https://greyfalconlabs.com

# --- Live MT5 report (optional backend bridge) ---
# The /live page renders mock data by default. To wire a real feed, expose an
# endpoint that returns the shape in src/lib/mt5.ts (Mt5Snapshot) and set:
# MT5_BRIDGE_URL=https://your-mt5-bridge.example.com/api/snapshot
# MT5_BRIDGE_TOKEN=replace-with-server-side-token
